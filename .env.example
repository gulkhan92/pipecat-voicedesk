# PostgreSQL connection used by the ingestion scripts and the retrieval module.
# Matches the docker-compose.yml defaults; override for a shared/staging instance.
POSTGRES_USER=voicedesk
POSTGRES_PASSWORD=voicedesk
POSTGRES_DB=voicedesk
POSTGRES_PORT=5433
DATABASE_URL=postgresql://voicedesk:voicedesk@localhost:5433/voicedesk

# Embedding model used for both knowledge base ingestion and query-time retrieval.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Voice pipeline provider keys (used starting Phase 3/4, not required for Phase 1).
GROQ_API_KEY=
GEMINI_API_KEY=

# Speech-to-text: Groq Whisper primary, local faster-whisper fallback.
GROQ_STT_MODEL=whisper-large-v3-turbo
WHISPER_FALLBACK_MODEL=Systran/faster-distil-whisper-medium.en
GROQ_STT_RECOVERY_SECS=60

# Text-to-speech: Kokoro, local, no API key required.
KOKORO_VOICE_ID=af_heart

# Phase 4: LLM provider layer (Groq primary, Gemini fallback) and retrieval.
GROQ_LLM_MODEL=openai/gpt-oss-20b
GEMINI_LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=120
GROQ_LLM_RPM_LIMIT=30
GEMINI_LLM_RPM_LIMIT=15
LLM_PROVIDER_RECOVERY_SECS=60
RETRIEVAL_TOP_K=3
MAX_HISTORY_TURNS=6

# Phase 5: conversation flow. Max clarifying follow-ups before escalation.
MAX_CLARIFICATION_ATTEMPTS=2

# Phase 7: observability. Jaeger (docker-compose) accepts OTLP/gRPC and
# serves its trace viewer UI at http://localhost:16686.
ENABLE_TRACING=true
OTLP_ENDPOINT=http://localhost:4317
TRACING_SERVICE_NAME=pipecat-voicedesk

# Whisker: live pipeline debugger, dev-only. View at https://whisker.pipecat.ai
# pointed at ws://localhost:9090 (only reachable while a call is active).
ENABLE_WHISKER=true
WHISKER_PORT=9090

# Phase 8: security and reliability.
# JWT auth for the client connection. Off by default in this standalone
# project; set REQUIRE_AUTH=true and JWT_SECRET to turn it on (see
# scripts/issue_dev_token.py for a local test token).
REQUIRE_AUTH=false
JWT_SECRET=
JWT_EXPIRY_SECS=3600

# New-call rate limiting per client IP.
CALL_START_RATE_LIMIT=5
CALL_START_RATE_WINDOW_SECS=60

# A call ends cleanly after this long, or after this much caller silence,
# whichever comes first.
MAX_CALL_DURATION_SECS=900
MAX_IDLE_SILENCE_SECS=30

# Spoken conversations can include sensitive personal information: the
# caller's/agent's words are stored by default only as a length, not the
# text itself. Set to true to opt in to storing the full transcript text.
STORE_FULL_TRANSCRIPTS=false

# Redis, used to track each LLM provider's rolling requests-per-minute quota.
# Matches the docker-compose.yml defaults; override for a shared/staging instance.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
