# PostgreSQL connection used by the ingestion scripts and the retrieval module.
# Matches the docker-compose.yml defaults; override for a shared/staging instance.
POSTGRES_USER=voicedesk
POSTGRES_PASSWORD=voicedesk
POSTGRES_DB=voicedesk
POSTGRES_PORT=5433
DATABASE_URL=postgresql://voicedesk:voicedesk@localhost:5433/voicedesk

# Embedding model used for both knowledge base ingestion and query-time retrieval.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Voice pipeline provider keys (used starting Phase 3/4, not required for Phase 1).
GROQ_API_KEY=
GEMINI_API_KEY=

# Speech-to-text: Groq Whisper primary, local faster-whisper fallback.
GROQ_STT_MODEL=whisper-large-v3-turbo
WHISPER_FALLBACK_MODEL=Systran/faster-distil-whisper-medium.en
GROQ_STT_RECOVERY_SECS=60

# Text-to-speech: Kokoro, local, no API key required.
KOKORO_VOICE_ID=af_heart
